# pytamil pylint configuration.
#
# Two standing decisions:
#   1. Tamil identifiers and file names are the design of this project, not an accident;
#      pylint's ASCII and snake_case/UPPER_CASE rules do not apply to them.
#   2. Everything under codegen/ is generated by ANTLR (codegen.sh) and never hand-edited,
#      so linting it has no value.

[MAIN]

# ANTLR-generated parsers/lexers/listeners: regenerate with ./codegen.sh, never hand-edit.
ignore-paths=^.*[/\\]codegen[/\\].*$

[MESSAGES CONTROL]

# Enable the message, report, category or checker with the given id(s). You can
# either give multiple identifier separated by comma (,) or put this option
# multiple time.
#enable=

# Disable the message, report, category or checker with the given id(s). You
# can either give multiple identifier separated by comma (,) or put this option
# multiple time (only on the command line, not in the configuration file where
# it should appear only once).
disable=C0103,C2401,C2403,W2402
# C0103:invalid-name — Tamil names (e.g. மாச்சீர்) do not fit UPPER_CASE/snake_case
# C2401:non-ascii-name
# C2403:non-ascii-module-import
# W2402:non-ascii-file-name — module file names are Tamil too (e.g. வெண்பா.py)

[BASIC]

# No docstring required for private helpers or for tests: a test's name
# (test_இயற்சீர்_வெண்டளை ...) already says what it checks.
no-docstring-rgx=^(_|test_)

[TYPECHECK]

# ANTLR-generated Parser subclasses define ruleNames and RULE_* as class attributes, but
# pytamil.தமிழ்.பாகுபடுத்தி only annotates the base antlr4.Parser, so pylint cannot see them.
generated-members=ruleNames,RULE_.*

[DESIGN]

# Small value objects (சான்று, விவரம், புணர்ச்சிவிதி) are normal here; requiring two
# public methods of them is meaningless.
min-public-methods=0
